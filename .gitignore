# ── Data artifacts (keep large datasets and model arrays out of git) ──────────
data/
!data/
data/*
!data/raw/
data/raw/*
!data/raw/README.md
!data/raw/LCDataDictionary.xlsx
*.npy
*.pkl
*.pt
*.parquet

# The compact, committed dashboard fixtures are the only parquet exception.
!dashboard/data/
!dashboard/data/*.parquet
!dashboard/data/*.json

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
*.egg

# ── Virtual environments ───────────────────────────────────────────────────────
venv/
.venv/
env/
.env

# ── Jupyter ───────────────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb_checkpoints

# ── IDE ───────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Kaggle credentials (NEVER commit) ─────────────────────────────────────────
kaggle.json
.kaggle/

# ── Logs ──────────────────────────────────────────────────────────────────────
logs/
*.joblib
*.pth
*.onnx
