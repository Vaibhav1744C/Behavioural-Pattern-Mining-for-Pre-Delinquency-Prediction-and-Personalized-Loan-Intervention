# ── Dataset files (never commit raw/large data) ───────────────────────────────
data/raw/*.csv
data/raw/*.gzip
data/raw/*.gz
data/raw/*.parquet
data/raw/*.zip
data/processed/*.parquet
data/processed/*.csv
data/synthetic/*.parquet
data/synthetic/*.csv

# Keep the README and dictionary in raw/
!data/raw/README.md
!data/raw/LCDataDictionary.xlsx

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
*.egg

# ── Virtual environments ───────────────────────────────────────────────────────
venv/
.venv/
env/
.env

# ── Jupyter ───────────────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb_checkpoints

# ── IDE ───────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Kaggle credentials (NEVER commit) ─────────────────────────────────────────
kaggle.json
.kaggle/

# ── Model artifacts (large files) ─────────────────────────────────────────────
*.pkl
*.joblib
*.pt
*.pth
*.onnx
